<?xml version="1.0" encoding="utf-8"?>
<!--
  The adaptive launcher icon, API 26 and above.

  **The background layer is the logo itself**, at the full 108 dp canvas, and
  the foreground is empty. An adaptive icon wants two layers; the artwork is a
  finished square picture with its own background, so it goes in the layer that
  is drawn full-bleed, and nothing is invented to sit in front of it.

  A launcher masks this to the middle 72 dp of the 108 dp canvas — see
  tools/icons/README.md for what that crops on this image.

  The mipmap-* ic_launcher.png files beside this one still matter: API 24 and
  25 are inside minSdk and get those instead.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@android:color/transparent" />
</adaptive-icon>
