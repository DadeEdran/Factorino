#!/bin/sh
# ---------------------------------------------------------------------------
# sanitize_lockfile — rewrite hosted package URLs in pubspec.lock back to pub.dev
#
# WHY THIS EXISTS
#
# pub.dev is unreachable from the primary development machine (HTTP 403, a
# geo-block presenting as an authorization error), so packages are resolved
# through a mirror via PUB_HOSTED_URL. pub writes that mirror's host into every
# hosted package entry in pubspec.lock.
#
# A committed lockfile naming a third-party mirror would impose that mirror on
# every other environment that checks this repository out. The requirement is
# that this repository builds unmodified on a machine with normal pub.dev
# access, so the lockfile must name pub.dev and nothing else.
#
# This rewrite is safe because the integrity guarantee does not live in the URL.
# Each hosted entry carries a `sha256` of the package archive, and a mirror
# serves byte-identical archives — that is what makes it a mirror. pub verifies
# the hash on download regardless of which host it came from. Rewriting the URL
# changes where a future resolve looks; it does not weaken what is verified.
#
# Run after every command that RESOLVES DEPENDENCIES. Idempotent.
#
# WHICH COMMANDS RESOLVE
#
# `flutter pub get` is the obvious one, and it is not the only one. Anything
# that ensures dependencies before doing its own work re-runs the resolve and
# writes the mirror host straight back:
#
#     flutter pub get            explicit
#     dart pub get               explicit
#     dart run build_runner ...  implicit -- resolves before generating
#     flutter gen-l10n           implicit
#     flutter test               implicit, when the lockfile looks stale
#     flutter build <target>     implicit, likewise
#
# So the rule is not "sanitize after pub get"; it is **sanitize before you
# commit, whatever you ran**. The pre-commit hook is the backstop and it does
# fire — this script is what makes satisfying it one reproducible command.
#
# ORDER MATTERS, AND IT IS THE OPPOSITE OF THE OBVIOUS ONE
#
# Run this LAST, after every command that resolves — never before one.
#
# The rewrite is what makes the next resolve reach for the network. pub does not
# accept a pub.dev entry as satisfying a mirror-sourced lock; it treats it as a
# different source and re-resolves. So a sanitized lockfile followed by
# `dart run build_runner build` sends pub to pub.dev, which is unreachable from
# this machine, and the build hangs at "Resolving dependencies..." with no error
# and no timeout of its own.
#
# That is not hypothetical. It cost most of a session (2026-08-24) and it cost
# part of another (2026-08-24, increment f2), because the symptom is "code
# generation hangs forever" rather than "the network is down" — `build_runner`
# resolves before it generates, so the failure surfaces in the wrong place.
#
# Right:   dart pub get --offline && dart run build_runner build
#          flutter gen-l10n && sh tools/sanitize_lockfile
# Wrong:   sh tools/sanitize_lockfile && dart run build_runner build
#
# When the mirror itself is unreachable, `dart pub get --offline` resolves the
# whole graph from the local pub cache with no network at all. See
# docs/ENVIRONMENT.md, "When the mirror is down".
#
# Measured: running `pub get` against an already-sanitized lockfile does not
# accept it. pub treats a pub.dev entry as a different source from a mirror
# entry, re-resolves, and reports "Changed N dependencies". The contamination
# is not a one-time cleanup; it returns on every resolve.
#
# USAGE
#     sh tools/sanitize_lockfile [path-to-pubspec.lock]
#
# Exits non-zero if any non-pub.dev host survives, so it is safe to chain:
#     flutter pub get && sh tools/sanitize_lockfile
#     dart run build_runner build && sh tools/sanitize_lockfile
#
# See docs/DECISIONS.md D-014. The .githooks/pre-commit hook is the backstop
# that catches a lockfile which was never sanitized.
# ---------------------------------------------------------------------------

set -e

LOCKFILE="${1:-pubspec.lock}"
CANONICAL="https://pub.dev"

if [ ! -f "$LOCKFILE" ]; then
    echo "sanitize_lockfile: no such file: $LOCKFILE" >&2
    exit 1
fi

TMP="${LOCKFILE}.sanitize.$$"
trap 'rm -f "$TMP"' EXIT INT TERM

# Rewrite `url:` only inside a description block belonging to `source: hosted`.
#
# Package entries look like:
#
#   package_name:
#     dependency: transitive
#     description:
#       name: package_name
#       sha256: "..."
#       url: "https://mirror.example/"      <- rewritten
#     source: hosted
#     version: "1.2.3"
#
# `source: git` entries also carry a `url:` field, and a git URL is a real
# code location rather than a redistribution host — rewriting one would point
# the build at the wrong repository. Anchoring on `source: hosted` is what
# keeps this script from corrupting those. Same for `sdk` and `path` sources.
awk -v canonical="$CANONICAL" '
    { line[NR] = $0 }
    END {
        rewritten = 0
        for (i = 1; i <= NR; i++) {
            if (line[i] ~ /^[[:space:]]*source:[[:space:]]*hosted[[:space:]]*$/) {
                # Walk back to this entry`s description block and fix its url.
                for (j = i - 1; j >= 1; j--) {
                    if (line[j] ~ /^[[:space:]]*description:[[:space:]]*$/) break
                    if (line[j] ~ /^[[:space:]]*url:[[:space:]]/) {
                        indent = line[j]
                        sub(/url:.*$/, "", indent)
                        replacement = indent "url: \"" canonical "\""
                        if (line[j] != replacement) {
                            line[j] = replacement
                            rewritten++
                        }
                    }
                }
            }
        }
        for (i = 1; i <= NR; i++) print line[i] > "/dev/stdout"
        print rewritten > "/dev/stderr"
    }
' "$LOCKFILE" > "$TMP" 2> "${TMP}.count"

COUNT=$(cat "${TMP}.count" 2>/dev/null || echo 0)
rm -f "${TMP}.count"

# Never leave a truncated lockfile behind if awk failed partway.
if [ ! -s "$TMP" ]; then
    echo "sanitize_lockfile: refusing to write an empty lockfile" >&2
    exit 1
fi

mv "$TMP" "$LOCKFILE"
trap - EXIT INT TERM

# Verify: no hosted entry may name any host other than pub.dev.
REMAINING=$(grep -nE '^[[:space:]]*url:' "$LOCKFILE" | grep -v "$CANONICAL" || true)
if [ -n "$REMAINING" ]; then
    echo "sanitize_lockfile: non-pub.dev host still present after rewrite:" >&2
    echo "$REMAINING" >&2
    exit 1
fi

if [ "$COUNT" -eq 0 ]; then
    echo "sanitize_lockfile: already canonical ($LOCKFILE)"
else
    echo "sanitize_lockfile: rewrote $COUNT url field(s) to $CANONICAL ($LOCKFILE)"
fi
