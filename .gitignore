/android/app/release

# Widget Preview related
.widget_preview/

# ---------------------------------------------------------------------------
# Factorino security hardening (the project spec "Secrets")
# Nothing below this line may ever be committed.
# ---------------------------------------------------------------------------

# Signing material — release keystores and their passwords
*.jks
*.keystore
*.p12
*.pfx
key.properties
android/key.properties
android/app/upload-keystore.jks

# Local configuration and secrets (--dart-define-from-file).
# Committed counterparts must use the *.example suffix and contain placeholders only.
.env
.env.*
!.env.example
config/*.json
!config/*.example.json
dart_define.json
!dart_define.example.json

# Exported backups — an encrypted backup is still the entire customer and
# invoice database in one portable artifact.
*.factorino-backup
backups/
exports/

# Local database files — these contain real user financial data
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Native build-hook download cache / artifacts
.dart_tool/native_assets/

